package models {
  class "actions.py" as actions_module <<módulo>> {
    +LOGIN: str = "Inicio de sesión"
    +LOGOUT: str = "Cierre de sesión"
    +PATIENT_REGISTRATION: str = "Registro de paciente"
    +TICKET_CREATION: str = "Generación de turno"
    +PATIENT_UPDATE: str = "Modificación de paciente"
    +CALL_NEXT: str = "Atención"
    +CARE_FINISHED: str = "Finalización de atención"
    +TICKET_CANCELLATION: str = "Cancelación de turno"
    +USER_MANAGEMENT: str = "Gestión de usuarios"
    +UNDONE: str = "Acción deshecha"
    +ACTION_TYPES: tuple[str, ...]
  }

  interface UndoContext <<protocolo>> {
    +patient_manager: PatientManager
    +ticket_manager: TicketManager
  }

  abstract class Action {
    #_action_type: str
    #_description: str
    #_username: str
    #_data: dict
    #_timestamp: str
    --
    +__init__(action_type: str, description: str, username: str,
    \tdata: dict | None = None, timestamp: str | None = None)
    +action_type: str «get»
    +description: str «get»
    +username: str «get»
    +data: dict[str, Any] «get»
    +timestamp: str «get»
    {abstract} +is_undoable: bool «get»
    +__str__(): str
  }

  class LogOnlyAction {
    +is_undoable: bool «get»
  }

  abstract class UndoableAction {
    #_undone: bool
    --
    +__init__(action_type: str, description: str, username: str,
    \tdata: dict | None = None, timestamp: str | None = None)
    +is_undoable: bool «get»
    +undone: bool «get»
    +undo(context: UndoContext): None
    {abstract} #_revert(context: UndoContext): None
  }

  class RegisterPatientAction {
    #_patient: Patient
    #_ticket: Ticket
    --
    +__init__(username: str, patient: Patient, ticket: Ticket)
    #_revert(context: UndoContext): None
  }

  class CreateTicketAction {
    #_ticket: Ticket
    --
    +__init__(username: str, ticket: Ticket)
    #_revert(context: UndoContext): None
  }

  class UpdatePatientAction {
    #_patient: Patient
    #_previous: dict
    --
    +__init__(username: str, patient: Patient, previous_values: dict)
    #_revert(context: UndoContext): None
  }

  class CallNextAction {
    #_ticket: Ticket
    --
    +__init__(username: str, ticket: Ticket)
    #_revert(context: UndoContext): None
  }

  class FinishCareAction {
    #_ticket: Ticket
    #_record: CareRecord
    --
    +__init__(username: str, ticket: Ticket, record: CareRecord)
    #_revert(context: UndoContext): None
  }

  class CancelTicketAction {
    #_ticket: Ticket
    #_position: int
    --
    +__init__(username: str, ticket: Ticket, position: int)
    +position: int «get»
    #_revert(context: UndoContext): None
  }
}

class Patient <<diagrama 1>>
class Ticket <<diagrama 1>>
class CareRecord <<diagrama 1>>
class PatientManager <<diagrama 3>>
class TicketManager <<diagrama 3>>
class ClinicSystem <<diagrama 3>>

' --- Herencia ---
Action <|-- LogOnlyAction
Action <|-- UndoableAction
UndoableAction <|-- RegisterPatientAction
UndoableAction <|-- CreateTicketAction
UndoableAction <|-- UpdatePatientAction
UndoableAction <|-- CallNextAction
UndoableAction <|-- FinishCareAction
UndoableAction <|-- CancelTicketAction

' --- Agregación: cada acción guarda los objetos que debe revertir ---
RegisterPatientAction o-- "1" Patient
RegisterPatientAction o-- "1" Ticket
CreateTicketAction o-- "1" Ticket
UpdatePatientAction o-- "1" Patient
CallNextAction o-- "1" Ticket
FinishCareAction o-- "1" Ticket
FinishCareAction o-- "1" CareRecord
CancelTicketAction o-- "1" Ticket

' --- Contexto del deshacer ---
UndoableAction ..> UndoContext : context
UndoContext ..> PatientManager
UndoContext ..> TicketManager
UndoContext <|.. ClinicSystem : cumple el protocolo

' --- Dependencias ---
Action ..> actions_module : usa los tipos

note bottom of UndoContext
  UndoContext es un typing.Protocol: describe lo que
  necesita undo() (los dos gestores) sin que nadie
  herede de él. ClinicSystem lo cumple porque tiene
  las propiedades patient_manager y ticket_manager;
  en las pruebas basta un objeto simple con esos dos
  atributos. Así actions.py no importa ClinicSystem
  y no hay importación circular.
end note

note bottom of CancelTicketAction
  Cada hija sobrescribe _revert() con su
  propia reversión (tabla de la sección 3.6).
  undo() lanza NotUndoableError si ya se deshizo.
  position deja ver la posición guardada en la cola.
end note

