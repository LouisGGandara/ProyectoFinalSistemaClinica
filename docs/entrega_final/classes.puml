package models {

  enum Permission <<enumeración>> {
    REGISTER_PATIENT = "Registrar paciente"
    UPDATE_PATIENT = "Modificar paciente"
    CREATE_TICKET = "Generar turno"
    SEARCH = "Buscar información"
    VIEW_QUEUES = "Ver colas"
    SERVE = "Atender pacientes"
    VIEW_CARE_HISTORY = "Ver historial de atendidos"
    VIEW_STATS = "Ver estadísticas"
    CANCEL_TICKET = "Cancelar turno"
    UNDO = "Deshacer la última acción"
    VIEW_ACTION_LOG = "Ver historial de acciones"
    MANAGE_USERS = "Administrar usuarios"
  }

  abstract class Person {
    #_full_name: str
    --
    +__init__(full_name: str)
    +full_name: str «get/set»
    {abstract} +description(): str
    +__str__(): str
  }

  abstract class User {
    {static} +SALT_BYTES: int = 16
    #_username: str
    -__password_hash: str
    #_salt: str
    --
    +__init__(full_name: str, username: str, password_hash: str, salt: str)
    +username: str «get»
    {abstract} +role: str «get»
    {abstract} +permissions(): set[Permission]
    +has_permission(permission: Permission): bool
    +verify_password(password: str): bool
    +change_password(new_password: str): None
    {static} #_compute_hash(password: str, salt: str): str
    {static} +create(full_name: str, username: str, password: str): User
    +to_dict(): dict
  }

  class Administrator {
    +role: str «get»
    +permissions(): set[Permission]
    +description(): str
  }

  class Receptionist {
    +role: str «get»
    +permissions(): set[Permission]
    +description(): str
  }

  class "user.py" as user_module <<módulo>> {
    +ADMINISTRATOR_ROLE: str = "Administrador"
    +RECEPTIONIST_ROLE: str = "Recepcionista"
    +ROLES: dict[str, type[User]]
    --
    +user_from_dict(data: dict): User
  }

  class Patient {
    #_code: str
    #_age: int
    #_phone: str
    #_registered_at: str
    --
    +__init__(code: str, full_name: str, age: int | str, phone: str,
    \tregistered_at: str | None = None)
    +code: str «get»
    +registered_at: str «get»
    +age: int «get/set»
    +phone: str «get/set»
    +description(): str
    +update_details(full_name: str, age: int | str, phone: str): dict
    +to_dict(): dict
    {static} +from_dict(data: dict): Patient
    +__str__(): str
  }

  abstract class CareType {
    {abstract} +name: str «get»
    {abstract} +prefix: str «get»
    {abstract} +is_priority: bool «get»
    +validate_for(patient: Patient): None
    +description(): str
    +to_dict(): dict
    +__str__(): str
  }

  class NormalCare {
    +name: str «get»
    +prefix: str «get»
    +is_priority: bool «get»
  }

  class PriorityCare {
    {static} +CRITERIA: tuple[str, ...] = ("Adulto mayor", "Embarazo", "Discapacidad", "Urgencia")
    {static} +SENIOR: str = "Adulto mayor"
    {static} +SENIOR_AGE: int = 60
    #_criterion: str
    --
    +__init__(criterion: str)
    +criterion: str «get»
    +name: str «get»
    +prefix: str «get»
    +is_priority: bool «get»
    +validate_for(patient: Patient): None
    +description(): str
    +to_dict(): dict
  }

  class "care_type.py" as care_type_module <<módulo>> {
    +NORMAL: str = "Normal"
    +PRIORITY: str = "Prioritaria"
    +CARE_TYPE_NAMES: tuple[str, str] = (NORMAL, PRIORITY)
    --
    +make_care_type(name: str, criterion: str | None = None): CareType
  }

  enum TicketStatus <<enumeración>> {
    PENDING = "Pendiente"
    IN_PROGRESS = "En atención"
    SERVED = "Atendido"
    CANCELLED = "Cancelado"
    --
    +is_active: bool «get»
  }

  class Ticket {
    {static} +NUMBER_DIGITS: int = 3
    {static} #_PREVIOUS_STATUS: dict[TicketStatus, TicketStatus]
    #_number: str
    #_patient: Patient
    #_care_type: CareType
    #_reason: str
    #_created_at: str
    #_status: TicketStatus
    #_served_at: str | None
    --
    +__init__(number: str, patient: Patient, care_type: CareType, reason: str,
    \tcreated_at: str | None = None, status: TicketStatus = TicketStatus.PENDING,
    \tserved_at: str | None = None)
    {static} +format_number(prefix: str, sequence: int): str
    {static} #_check_number(number: str, care_type: CareType): str
    #_check_served_at(served_at: str | None): str | None
    +number: str «get»
    +patient: Patient «get»
    +care_type: CareType «get»
    +reason: str «get»
    +created_at: str «get»
    +status: TicketStatus «get»
    +served_at: str | None «get»
    +sequence: int «get»
    +is_active: bool «get»
    +start_care(): None
    +finish_care(): None
    +cancel(): None
    +revert_to(status: TicketStatus): None
    +to_dict(): dict
    {static} +from_dict(data: dict, patients_by_code: dict[str, Patient]): Ticket
    +__str__(): str
  }

  class CareRecord {
    #_ticket_number: str
    #_patient_code: str
    #_patient_name: str
    #_care_type: str
    #_registered_at: str
    #_served_at: str
    #_served_by: str
    --
    +__init__(ticket_number: str, patient_code: str, patient_name: str, care_type: str,
    \tregistered_at: str, served_at: str, served_by: str)
    +ticket_number: str «get»
    +patient_code: str «get»
    +patient_name: str «get»
    +care_type: str «get»
    +registered_at: str «get»
    +served_at: str «get»
    +served_by: str «get»
    {static} +from_ticket(ticket: Ticket, username: str): CareRecord
    +to_dict(): dict
    {static} +from_dict(data: dict): CareRecord
    +__str__(): str
  }

  note bottom of PriorityCare
    Sobrescribe validate_for(): el criterio SENIOR
    ("Adulto mayor") exige SENIOR_AGE años o más.
    NormalCare hereda la versión que no valida nada.
  end note

  note right of Ticket
    El estado solo cambia con start_care(),
    finish_care() y cancel(), que revisan la
    transición (sección 3.4). revert_to() lo
    usan solamente las acciones al deshacer, y
    solo acepta volver al estado anterior que
    indica _PREVIOUS_STATUS; si no, lanza
    NotUndoableError.
    _check_number() exige que el prefijo del
    número coincida con el tipo de atención, y
    _check_served_at() que solo un turno Atendido
    tenga fecha de atención. Así un tickets.json
    editado a mano no carga datos incoherentes.
  end note

  note bottom of Patient
    Los setters de full_name, age y phone validan con
    Validator (diagrama 5). update_details() valida los
    tres valores antes de cambiar alguno y devuelve los
    anteriores para poder deshacer.
  end note

  note bottom of Receptionist
    permissions(): Administrator devuelve todos los
    permisos; Receptionist, todos menos CANCEL_TICKET,
    UNDO, VIEW_ACTION_LOG y MANAGE_USERS (sección 3.1).
    El valor de cada permiso es el texto en español que
    muestra la pestaña Usuarios.
  end note

  note bottom of User
    create() es @classmethod: genera la sal con
    secrets.token_hex(SALT_BYTES) y calcula el hash
    SHA-256. Administrator.create(...) devuelve un
    Administrator. user_from_dict() elige la clase
    con el diccionario ROLES.
  end note
}

' --- Herencia ---
Person <|-- User
Person <|-- Patient
User <|-- Administrator
User <|-- Receptionist
CareType <|-- NormalCare
CareType <|-- PriorityCare

' --- Composición y agregación ---
Ticket "1" *-- "1" CareType : care_type
Patient "1" --o "0..*" Ticket : patient
Ticket ..> TicketStatus : status

' --- Dependencias ---
User ..> Permission : usa
Administrator <.. user_module : crea
Receptionist <.. user_module : crea
NormalCare <.. care_type_module : crea
PriorityCare <.. care_type_module : crea
Patient <.. PriorityCare : valida la edad
Ticket <.. CareRecord : se crea desde

legend right
  - privado   # protegido   + público
  //cursiva//: abstracto    __subrayado__: de clase
  «get»: solo lectura   «get/set»: setter que valida
  gris: se detalla en otro diagrama
endlegend
@enduml


