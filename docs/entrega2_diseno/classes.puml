' ============================================================================
' Sistema de atención y gestión de turnos de una clínica
' Paso B1. Diagrama de clases UML
'
' El diagrama se divide en las tres partes que sugiere el paso B1, y cada
' parte en una o más vistas para que se lean en una página:
'   Parte 1. Modelos (paquete models)
'     1. modelos            personas, pacientes, tipos de atención y turnos
'     2. acciones           acciones del historial
'   Parte 2. Servicios y estructuras (services, structures, persistence, utils)
'     3. servicios          fachada, gestores, cola, estadísticas y persistencia
'     4. historial_busqueda historial de acciones, pila y búsquedas
'     5. utilidades         excepciones, validador y fechas
'   Parte 3. Interfaz (paquete ui)
'     6. interfaz           ventanas y pestañas de Tkinter
'
' Relaciones: solo herencia, composición, agregación y dependencia (paso B1).
'
' Exportar: java -jar plantuml.jar -tpng classes.puml   (o -tsvg)
' Cada bloque @startuml genera su propia imagen con el nombre del bloque.
'
' Convenciones
'   -  privado      #  protegido      +  público
'   cursiva                 clase o método abstracto
'   subrayado               atributo o método de clase (static, classmethod)
'   «get»                   propiedad de solo lectura (@property)
'   «get/set»               propiedad con setter que valida
'   clases grises           se detallan en otro diagrama
' ============================================================================


' ============================================================================
' 1. MODELOS
' ============================================================================
@startuml modelos
title Diagrama 1. Modelos: personas, pacientes, tipos de atención y turnos
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 40
skinparam ranksep 50
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #444444
  ArrowColor #444444
}
skinparam class<<módulo>> {
  BackgroundColor #F6F3E8
}

package models {

  enum Permission <<enumeración>> {
    REGISTER_PATIENT
    UPDATE_PATIENT
    CREATE_TICKET
    SEARCH
    VIEW_QUEUES
    SERVE
    VIEW_CARE_HISTORY
    VIEW_STATS
    CANCEL_TICKET
    UNDO
    VIEW_ACTION_LOG
    MANAGE_USERS
  }

  abstract class Person {
    #_full_name: str
    --
    +__init__(full_name: str)
    +full_name: str «get/set»
    {abstract} +description(): str
    +__str__(): str
  }

  abstract class User {
    #_username: str
    -__password_hash: str
    #_salt: str
    --
    +__init__(full_name: str, username: str, password_hash: str, salt: str)
    +username: str «get»
    {abstract} +role: str «get»
    {abstract} +permissions(): set[Permission]
    +has_permission(permission: Permission): bool
    +verify_password(password: str): bool
    {static} #_compute_hash(password: str, salt: str): str
    {static} +create(full_name: str, username: str, password: str): User
    +to_dict(): dict
  }

  class Administrator {
    +role: str «get»
    +permissions(): set[Permission]
    +description(): str
  }

  class Receptionist {
    +role: str «get»
    +permissions(): set[Permission]
    +description(): str
  }

  class "user.py" as user_module <<módulo>> {
    +user_from_dict(data: dict): User
  }

  class Patient {
    #_code: str
    #_age: int
    #_phone: str
    #_registered_at: str
    --
    +__init__(code: str, full_name: str, age: int, phone: str, registered_at: str | None = None)
    +code: str «get»
    +registered_at: str «get»
    +age: int «get/set»
    +phone: str «get/set»
    +description(): str
    +update_details(full_name: str, age: int, phone: str): dict
    +to_dict(): dict
    {static} +from_dict(data: dict): Patient
    +__str__(): str
  }

  abstract class CareType {
    {abstract} +name: str «get»
    {abstract} +prefix: str «get»
    {abstract} +is_priority: bool «get»
    +validate_for(patient: Patient): None
    +description(): str
    +to_dict(): dict
  }

  class NormalCare {
    +name: str «get»
    +prefix: str «get»
    +is_priority: bool «get»
  }

  class PriorityCare {
    {static} +CRITERIA: tuple[str, ...] = ("Adulto mayor", "Embarazo", "Discapacidad", "Urgencia")
    {static} +SENIOR_AGE: int = 60
    #_criterion: str
    --
    +__init__(criterion: str)
    +criterion: str «get»
    +name: str «get»
    +prefix: str «get»
    +is_priority: bool «get»
    +validate_for(patient: Patient): None
    +description(): str
    +to_dict(): dict
  }

  class "care_type.py" as care_type_module <<módulo>> {
    +make_care_type(name: str, criterion: str | None = None): CareType
  }

  enum TicketStatus <<enumeración>> {
    PENDING = "Pendiente"
    IN_PROGRESS = "En atención"
    SERVED = "Atendido"
    CANCELLED = "Cancelado"
    --
    +is_active: bool «get»
  }

  class Ticket {
    #_number: str
    #_patient: Patient
    #_care_type: CareType
    #_reason: str
    #_created_at: str
    #_status: TicketStatus
    #_served_at: str | None
    --
    +__init__(number: str, patient: Patient, care_type: CareType, reason: str,
    \tcreated_at: str | None = None, status: TicketStatus = TicketStatus.PENDING,
    \tserved_at: str | None = None)
    +number: str «get»
    +patient: Patient «get»
    +care_type: CareType «get»
    +reason: str «get»
    +created_at: str «get»
    +status: TicketStatus «get»
    +served_at: str | None «get»
    +sequence: int «get»
    +is_active: bool «get»
    +start_care(): None
    +finish_care(): None
    +cancel(): None
    +revert_to(status: TicketStatus): None
    +to_dict(): dict
    {static} +from_dict(data: dict, patients_by_code: dict[str, Patient]): Ticket
    +__str__(): str
  }

  class CareRecord {
    #_ticket_number: str
    #_patient_code: str
    #_patient_name: str
    #_care_type: str
    #_registered_at: str
    #_served_at: str
    #_served_by: str
    --
    +__init__(ticket_number: str, patient_code: str, patient_name: str, care_type: str,
    \tregistered_at: str, served_at: str, served_by: str)
    +ticket_number: str «get»
    +patient_code: str «get»
    +patient_name: str «get»
    +care_type: str «get»
    +registered_at: str «get»
    +served_at: str «get»
    +served_by: str «get»
    {static} +from_ticket(ticket: Ticket, username: str): CareRecord
    +to_dict(): dict
    {static} +from_dict(data: dict): CareRecord
  }

  note bottom of PriorityCare
    Sobrescribe validate_for(): el criterio
    "Adulto mayor" exige SENIOR_AGE años o más.
    NormalCare hereda la versión que no valida nada.
  end note

  note right of Ticket
    El estado solo cambia con start_care(),
    finish_care() y cancel(), que revisan la
    transición (sección 3.4). revert_to() lo
    usan solamente las acciones al deshacer.
  end note

  note bottom of Patient
    Los setters de full_name, age y phone validan con
    Validator (diagrama 5). update_details() valida los
    tres valores antes de cambiar alguno y devuelve los
    anteriores para poder deshacer.
  end note

  note bottom of Receptionist
    permissions(): Administrator devuelve todos los
    permisos; Receptionist, todos menos CANCEL_TICKET,
    UNDO, VIEW_ACTION_LOG y MANAGE_USERS (sección 3.1).
  end note

  note bottom of User
    create() es @classmethod: genera la sal con
    secrets.token_hex(16) y calcula el hash SHA-256.
    Administrator.create(...) devuelve un Administrator.
  end note
}

' --- Herencia ---
Person <|-- User
Person <|-- Patient
User <|-- Administrator
User <|-- Receptionist
CareType <|-- NormalCare
CareType <|-- PriorityCare

' --- Composición y agregación ---
Ticket "1" *-- "1" CareType : care_type
Patient "1" --o "0..*" Ticket : patient
Ticket ..> TicketStatus : status

' --- Dependencias ---
User ..> Permission : usa
Administrator <.. user_module : crea
Receptionist <.. user_module : crea
NormalCare <.. care_type_module : crea
PriorityCare <.. care_type_module : crea
Patient <.. PriorityCare : valida la edad
Ticket <.. CareRecord : se crea desde

legend right
  - privado   # protegido   + público
  //cursiva//: abstracto    __subrayado__: de clase
  «get»: solo lectura   «get/set»: setter que valida
  gris: se detalla en otro diagrama
endlegend
@enduml


