package services {
  class ActionHistory {
    #_history_stack: Stack
    #_undo_stack: Stack
    --
    +__init__()
    +register(action: Action): None
    +last_action(): Action
    +list_all(): list[Action]
    +has_actions(): bool
    +can_undo(): bool
    +undo_last(context, username: str): Action
  }

  note right of ActionHistory
    Dos objetos Stack (sección 3.7):
    _history_stack guarda todas las acciones;
    _undo_stack guarda solo las deshacibles.
    Un inicio de sesión nunca bloquea el deshacer.
    Si undo() falla, la acción vuelve a la pila
    y el error se relanza.
  end note
  abstract class SearchCriterion {
    {abstract} +name: str «get»
    {abstract} +matches(ticket: Ticket, text: str): bool
    {static} #_normalize(text: str): str
  }

  class ByPatientCode {
    +name: str «get»
    +matches(ticket: Ticket, text: str): bool
  }
  class ByPatientName {
    +name: str «get»
    +matches(ticket: Ticket, text: str): bool
  }
  class ByTicketNumber {
    +name: str «get»
    +matches(ticket: Ticket, text: str): bool
  }
  class ByStatus {
    +name: str «get»
    +matches(ticket: Ticket, text: str): bool
  }
  class ByCareType {
    +name: str «get»
    +matches(ticket: Ticket, text: str): bool
  }

  class "search.py" as search_module <<módulo>> {
    +CRITERIA: dict[str, SearchCriterion]
    +search(tickets: list[Ticket], criterion_name: str, text: str): list[Ticket]
  }

  note right of SearchCriterion
    Cada criterio sobrescribe matches() con su comparación.
    search() busca el criterio en CRITERIA y llama a matches()
    sin saber de qué clase es (polimorfismo).
    _normalize() pasa a minúsculas, junta espacios y quita tildes,
    por eso "mar" encuentra a María y a Marco (RF-33).
    Código y número de turno se comparan exactos; nombre, parcial.
    Claves de CRITERIA (lo que ve el usuario): "Código de paciente",
    "Nombre", "Número de turno", "Estado", "Tipo de atención".
  end note
}

